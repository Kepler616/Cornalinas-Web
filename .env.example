# Copia este archivo a ".env" para desarrollo local con `vercel dev`
# (nunca subas el .env real a git — ya está en .gitignore).
#
# En producción, configura estas mismas variables en el dashboard de
# Vercel: Project Settings → Environment Variables.

# Clave secreta de Stripe (empieza con sk_test_... en modo prueba,
# sk_live_... en producción). Se obtiene en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# URL pública del sitio en producción (sin barra final), usada para
# construir las URLs de éxito/cancelación de Stripe Checkout.
# En local puedes dejarla vacía: se usa http://localhost:5173 por defecto.
PUBLIC_SITE_URL=
